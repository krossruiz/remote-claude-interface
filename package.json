    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/ws": "^8.5.8",
    "@types/cors": "^2.8.15",
    "@types/node": "^20.9.0",
    "@types/uuid": "^9.0.6",
    "typescript": "^5.2.2"
  }
